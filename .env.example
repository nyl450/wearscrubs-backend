# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://...

# Auth
JWT_SECRET=your_jwt_secret_here

# Supabase Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_key_here
SUPABASE_BUCKET=wearscrubs
# Bucket PRIVAT untuk bukti order/refund (diakses via signed URL). Default: wearscrubs-orders
SUPABASE_PRIVATE_BUCKET=wearscrubs-orders

# WhatsApp (opsional)
FONNTE_TOKEN=your_fonnte_token

# PORT (Railway mengisi otomatis)
PORT=3000
